# -----------------------------------------------------------------------------
# Red Neuro Backend - Variables de entorno de ejemplo
# Copia este archivo a .env y reemplaza los valores de ejemplo por los reales.
# -----------------------------------------------------------------------------

# Datos de despliegue
NODE_ENV=development
PORT=4500
PATH_SUBDOMAIN=api
REQUEST_TIMEOUT_IN_SECONDS=30

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_DATABASE=redneurodb

DB_SCHEMA=proyecto
DB_SCHEMA_USUARIOS=usuarios
DB_SCHEMA_HISTORIAL=historial

# Parámetros funcionales del dominio
CITA_CONSULTA_DURACION_MINUTOS=15

# Datos institucionales para correos y mensajes
EMPRESA_NOMBRE=Centro Neurológico NeuroAX
EMPRESA_CELULAR=70000000
EMPRESA_CORREO=contacto@neuroax.bo

# Autenticación y sesiones
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRES_IN=30000000000
SESSION_SECRET=__SESSION_SECRET__

REFRESH_TOKEN_NAME=jid
REFRESH_TOKEN_EXPIRES_IN=36000000000
REFRESH_TOKEN_ROTATE_IN=90000000
REFRESH_TOKEN_SECURE=false
REFRESH_TOKEN_DOMAIN=localhost
REFRESH_TOKEN_PATH=/
REFRESH_TOKEN_REVISIONS=*/5 * * * *

# Mensajería / correo
EMAIL_USER=notificaciones@example.com
EMAIL_PASSWORD=__EMAIL_PASSWORD__
EMAIL_RESPONSE_TIMEOUT=10

# URL del frontend para enlaces de recuperación, activación, etc.
URL_FRONTEND=http://localhost:9500/

# Almacenamiento de archivos
STORAGE_NFS_PATH=./tmp/storage/

# Evaluaciones nutricionales - archivos adjuntos
EVAL_NUTRI_MAX_FILES=5
EVAL_NUTRI_MAX_FILE_MB=10

# Logging
LOG_ENABLED=true
LOG_LEVEL=info
LOG_AUDIT=application request response authentication mensajeria
LOG_CONSOLE=true
LOG_SQL=true
LOG_HTTP_TRACE=true

LOG_FILE_ENABLED=true
LOG_FILE_PATH=./tmp/logs/
LOG_FILE_SIZE=50M
LOG_FILE_INTERVAL=YM

LOG_LOKI_ENABLED=false
LOG_LOKI_URL=http://localhost:3100/
LOG_LOKI_USERNAME=
LOG_LOKI_PASSWORD=
LOG_LOKI_BATCHING=true
LOG_LOKI_BATCH_INTERVAL=5

# Notificaciones móviles y tareas programadas
NOTIF_DAILY_SUMMARY_ENABLED=true
NOTIF_DAILY_SUMMARY_HOUR=06:45
NOTIF_PUSH_ALWAYS=true
CITAS_AUTO_NO_ASISTIO_ENABLED=true
CITAS_AUTO_NO_ASISTIO_CRON=0 1 * * *

# Política de versión para aplicación móvil consumida desde GET /api/estado
MOBILE_ANDROID_MIN_VERSION=1.8.0
MOBILE_ANDROID_STABLE_VERSION=1.9.3
MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=bo.redneuro.app
MOBILE_IOS_MIN_VERSION=1.7.5
MOBILE_IOS_STABLE_VERSION=1.8.2
MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id123456789

# Proveedor push / Firebase Admin SDK
PUSH_PROVIDER=fcm
FCM_CREDENTIALS_FILE=settings/red-neuro-firebase-adminsdk-fbsvc-2cd16b87d5.json
