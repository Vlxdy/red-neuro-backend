{
  "name": "redneuro-backend",
  "version": "1.12.0",
  "description": "Red Neuro Backend",
  "author": "Vladimir Copa Fabián <vcopafabian@gmail.com>",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.6.4",
  "scripts": {
    "build": "nest build",
    "build-docker": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format-check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "setup": "npm run migrations:clean && npm run schema:drop && npm run migrations:generate database/migrations/init && npm run migrations:run && npm run seeds:run",
    "dev": "LOG_SQL=true LOG_CONSOLE=true LOG_LEVEL=debug npm run start:dev",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "db:create": "bash ./database/scripts/dbcreate_docker.sh",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --verbose --coverage=false",
    "test:single": "NODE_ENV=test jest --coverage=false -i",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:cov": "NODE_ENV=test jest --coverage",
    "test:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json",
    "test:ci": "NODE_ENV=test jest --collectCoverage --ci --reporters=default --reporters=jest-junit --watchAll=false",
    "typeorm": "NODE_OPTIONS=--max_old_space_size=8192 ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migrations:clean": "rimraf database/migrations/*",
    "migrations:generate": "npm run typeorm -- migration:generate -d ormconfig-default.ts",
    "migrations:run": "npm run typeorm -- migration:run -d ormconfig-default.ts",
    "migrations:revert": "npm run typeorm -- migration:revert -d ormconfig-default.ts",
    "seeds:create": "npm run typeorm -- migration:create",
    "seeds:run": "npm run typeorm -- migration:run -d ormconfig-seed.ts",
    "schema:drop": "npm run typeorm -- schema:drop -d ormconfig-default.ts",
    "rimraf": "./node_modules/rimraf/bin.js",
    "compodoc": "compodoc -p tsconfig.json -o --language es-ES --disableCoverage --hideGenerator",
    "db:diagram": "ts-node ./node_modules/.bin/typeorm-uml ormconfig-default.ts -d ormconfig-default.ts -d docs/ERD.png",
    "prepare": "husky",
    "check-node-version": "node ./node_modules/.bin/check-node-version",
    "prebuild": "npm run check-node-version && rimraf dist && npm run lint",
    "presetup": "npm run check-node-version",
    "prestart": "npm run check-node-version",
    "prestart:dev": "npm run check-node-version",
    "pretest": "npm run check-node-version",
    "preinstall": "mkdir -p node_modules && touch ./node_modules/.metadata_never_index",
    "postinstall": "npm run check-node-version",
    "release": "commit-and-tag-version",
    "data:fake": "ts-node -r tsconfig-paths/register scripts/data-fake/poblar.ts"
  },
  "dependencies": {
    "@elartedelcodigo/check-node-version": "1.3.3",
    "@golevelup/ts-jest": "0.7.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.9",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.9",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/platform-socket.io": "11.1.9",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "11.1.9",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cls-rtracer": "2.6.3",
    "connect-typeorm": "2.0.0",
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.19",
    "dotenv": "17.2.3",
    "ejs": "3.1.10",
    "express-list-endpoints": "7.1.1",
    "express-session": "1.18.2",
    "file-stream-rotator": "1.0.0",
    "file-type": "21.1.1",
    "flatted": "3.3.3",
    "helmet": "8.1.0",
    "html-to-pdfmake": "2.5.32",
    "husky": "9.1.7",
    "ip-address": "10.1.0",
    "jsdom": "27.2.0",
    "nanoid": "5.1.6",
    "nodemailer": "7.0.11",
    "openid-client": "5.7.1",
    "pako": "2.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pdfmake": "0.2.20",
    "pg": "8.16.3",
    "pino": "10.1.0",
    "pino-loki": "2.6.0",
    "rimraf": "6.1.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "sql-formatter": "15.6.10",
    "typeorm": "0.3.27",
    "typeorm-adapter": "1.8.0",
    "uuid": "13.0.0",
    "zxcvbn-typescript": "5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@compodoc/compodoc": "1.1.32",
    "@faker-js/faker": "10.1.0",
    "@nestjs/cli": "11.0.13",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.9",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/express-session": "1.18.2",
    "@types/html-to-pdfmake": "2.4.4",
    "@types/jest": "30.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/pako": "2.0.4",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pdfmake": "0.2.12",
    "@types/supertest": "6.0.3",
    "@types/zxcvbn": "4.4.5",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "commit-and-tag-version": "12.6.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "30.2.0",
    "jest-junit": "16.0.0",
    "jest-sonar-reporter": "2.0.0",
    "nestjs-asyncapi": "1.4.0",
    "prettier": "3.7.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageReporters": [
      "html",
      "text",
      "text-summary",
      "cobertura"
    ],
    "coveragePathIgnorePatterns": [
      "src/main.ts",
      "src/database/migrations/",
      "src/database/seeds/",
      ".module.ts",
      ".entity.ts",
      ".dto.ts",
      ".guard.ts",
      ".enum.ts"
    ],
    "collectCoverage": true,
    "testResultsProcessor": "jest-sonar-reporter",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "jest-junit": {
    "outputDirectory": "./coverage"
  },
  "engines": {
    "node": "^24",
    "npm": ">=11"
  }
}
